{
  "name": "airdesk-desktop-host",
  "version": "0.9.0",
  "description": "AirDesk Unified Electron Desktop Host — Adaptive HW encode detection, LAN/Hotspot UDP discovery, Android APK & PWA dual-client support, low-latency WebRTC, bidirectional file transfer & optional SYSTEM input service.",
  "author": "AirDesk Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andabaoyue/AirDesk.git"
  },
  "homepage": "https://github.com/andabaoyue/AirDesk#readme",
  "bugs": {
    "url": "https://github.com/andabaoyue/AirDesk/issues"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node test/run-tests.mjs",
    "prebuild:win": "C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /optimize+ /r:System.Web.Extensions.dll /out:native\\airdesk-win-helper.exe native\\win-input-helper.cs && C:\\Windows\\Microsoft.NET\\Framework64\\v4.0.30319\\csc.exe /nologo /optimize+ /r:System.ServiceProcess.dll /r:System.Web.Extensions.dll /out:native\\airdesk-elevated-service.exe native\\win-elevated-service.cs",
    "build:win": "electron-builder --win nsis zip --publish never",
    "prebuild:mac": "swiftc -O native/mac-input-helper.swift -o native/airdesk-mac-helper",
    "build:mac": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.airdesk.host",
    "productName": "AirDesk Host",
    "files": [
      "electron/**/*",
      "electron/modules/**/*",
      "native/**/*",
      "renderer/**/*",
      "renderer/modules/**/*"
    ],
    "asarUnpack": [
      "native/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": "dmg",
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "AirDesk 需要屏幕录制权限以采集并串流桌面画面。",
        "NSAppleEventsUsageDescription": "AirDesk 需要辅助控制权限以注入远程鼠标与键盘操作。"
      }
    }
  }
}