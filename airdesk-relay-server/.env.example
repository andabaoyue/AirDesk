# AirDesk Relay Server configuration example
# Copy to .env when running locally or inject via docker-compose / systemd

PORT=47820
HOST=0.0.0.0

# Optional: require a shared access key for host:create and GET /api/ice (header: X-AirDesk-Access-Key)
RELAY_ACCESS_KEY=

# Set to true only when deployed behind a trusted reverse proxy (Caddy / Nginx) so X-Forwarded-For is used for rate-limiting
TRUST_PROXY=false

# Comma-separated STUN servers returned to peers
STUN_URLS=stun:stun.miwifi.com:3478,stun:stun.l.google.com:19302

# Optional TURN relay servers (for strict/symmetric NAT traversal)
# TURN_URLS=turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp
# TURN_SECRET=replace-with-strong-random-secret
# TURN_TTL_SEC=86400

# Static TURN credentials (used only if TURN_SECRET is empty)
# TURN_USERNAME=
# TURN_CREDENTIAL=
